ENVIRONMENT=local
DEBUG=true

# Settings are read from this file, or from whatever ENV_FILE names:
#   ENV_FILE=.env.dev uv run uvicorn app.main:app --reload --port 8090
# .env.dev points at a local database and needs no Supabase credentials.
#
# --- Supabase database -------------------------------------------------------
# Dashboard > Project Settings > Database > Connection string.
# Supabase hosts exactly one database ("postgres"); the app lives in its
# "public" schema. There is no local/docker postgres any more.
#
# Runtime pool: "Transaction pooler" (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations, tests and other DDL: "Session pooler" (port 5432), or the direct
# db.<project-ref>.supabase.co:5432 host if your network has IPv6.
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

DB_SSL=require
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# pytest builds and drops this schema on every run. Never point it at "public".
TEST_SCHEMA=bakhoora_test

# --- Supabase platform (storage / edge functions) ----------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# openssl rand -hex 32
SECRET_KEY=replace-me-with-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

CURRENCY=BDT
SHIPPING_FLAT_FEE=70
FREE_SHIPPING_THRESHOLD=3000
LOW_STOCK_THRESHOLD=5

# With ENVIRONMENT=local, any http://localhost:<port> origin is accepted on top
# of this list — `next dev` moves between 3000/3001/3002 as ports fill up.
# Deployed, only this list and CORS_ORIGIN_REGEX are trusted.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# e.g. ^https://.*\.bakhoora\.bd$ — leave empty unless you need a pattern.
CORS_ORIGIN_REGEX=

FIRST_ADMIN_EMAIL=admin@bakhoora.bd
FIRST_ADMIN_PASSWORD=Admin123!
